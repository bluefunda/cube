# Multi-stage: copy oauth2-proxy binary into Alpine so apk works
FROM quay.io/oauth2-proxy/oauth2-proxy:v7.6.0 AS oauth2proxy

FROM alpine:3.19
# Install curl and jq for Vault JSON parsing
RUN apk add --no-cache curl jq ca-certificates

# Copy oauth2-proxy binary from official image
COPY --from=oauth2proxy /bin/oauth2-proxy /bin/oauth2-proxy

# Vault entrypoint: fetches Keycloak client_secret and cookie_secret from Vault
COPY oauth2-proxy-entrypoint.sh /oauth2-proxy-entrypoint.sh
RUN chmod +x /oauth2-proxy-entrypoint.sh

ENTRYPOINT ["/oauth2-proxy-entrypoint.sh"]
